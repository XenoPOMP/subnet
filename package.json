  "scripts": {
    "next": "next",
    "dev": "yarn next dev",
    "build": "yarn next build",
    "start": "yarn next start",
    "lint": "yarn next lint",
    "deploy": "yarn build && yarn start",
    "unit:test": "vitest -c .config/vitest.config.ts",
    "coverage": "vitest -c .config/vitest.config.ts run --coverage",
    "coverage:watch": "vitest -c .config/vitest.config.ts --coverage",
    "postcoverage": "cp ./node_modules/nyc-dark/*.css coverage/",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress open --config-file .config/cypress.config.ts --e2e\"",
    "e2e:ci": "start-server-and-test dev http://localhost:3000 \"cypress run --config-file .config/cypress.config.ts --e2e\"",
    "lint:code": "eslint --max-warnings=0",
    "lint:css": "stylelint -c ./.config/.stylelintrc.js --ignore-path ./.config/.stylelintignore **/*.{css,scss}",
    "lint:ci": "yarn lint:code && yarn lint:css",
    "cypress:open": "cypress open",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "fullpack": "run-s pack:**",
    "pack:env": "tsx .config/.dev/scripts/pack-env.ts",
    "pack:node:semver": "tsx .config/.dev/scripts/caclulate-engine-reqs.ts",
    "knip": "knip",
    "knip:deps": "yarn knip --dependencies",
    "tauri:dev": "yarn tauri dev",
    "tauri:build": "cross-env IS_TAURI=1 yarn tauri build"
